# AksiBareng — salin jadi .env lalu isi nilai sebenarnya.
# .env tidak pernah di-commit (lihat AGENTS.md §Aturan wajib).

# Database
DATABASE_URL="postgresql://aksibareng:aksibareng@localhost:5432/aksibareng"

# Auth (Auth.js) — buat sendiri: openssl rand -base64 32
AUTH_SECRET=""
APP_URL="http://localhost:3000"

# Token & hash
QR_TOKEN_SECRET=""        # beda dari AUTH_SECRET
EVIDENCE_PEPPER=""        # salt hash bukti sebelum di-anchor ke chain

# Jaringan testnet
SEPOLIA_RPC_URL=""        # https://sepolia.infura.io/v3/<key> atau Alchemy
CHAIN_ID="11155111"
NEXT_PUBLIC_DONATION_CONTRACT=""      # diisi setelah deploy (T4.2)
NEXT_PUBLIC_REGISTRY_CONTRACT=""
INDEXER_RELAYER_PRIVATE_KEY=""  # KUNCI TESTNET SAJA — jangan mainnet
ETHERSCAN_API_KEY=""           # untuk verifikasi kontrak di Etherscan

# Storage privat (bukti pengeluaran & distribusi)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
